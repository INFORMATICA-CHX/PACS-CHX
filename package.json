{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run server:bytecode && set ELECTRON_RUN_AS_NODE=&& electron .",
    "desktop:build": "npm run build && npm run desktop",
    "server:bytecode": "node scripts/build-server-bytecode.cjs",
    "service:build": "node scripts/build-service-host.cjs",
    "dist:win": "npm run build && npm run server:bytecode && npm run service:build && electron-builder --win",
    "license-manager": "npm --prefix license-manager start",
    "seed:demo": "node server/scripts/seed-demo.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.344.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "br.com.pacschx.desktop",
    "productName": "PACS CHX",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "server/build/**/*",
      "server/certs/**/*",
      "server/python/**/*",
      "server/license-public.pem",
      "server/package.json",
      "server/node_modules/**/*",
      "service/bin/PacsChxServiceHost.exe",
      "package.json",
      "node_modules/bytenode/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/sax/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "node_modules/bytenode/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "runtime/node",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": "runtime/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "service/bin",
        "to": "service",
        "filter": [
          "PacsChxServiceHost.exe"
        ]
      }
    ],
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PACS-CHX-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release",
        "owner": "INFORMATICA-CHX",
        "repo": "PACS-CHX"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
